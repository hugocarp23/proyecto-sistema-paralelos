# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL (Supabase o Local)
# Ejemplo Supabase Transaction Pooler (puerto 6543) o Session (5432):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Ejemplo Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventhub_db?schema=public"

# Seguridad y Autenticación JWT
JWT_SECRET="eventhub_super_secret_jwt_token_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Orígenes Permitidos para CORS (Frontend)
FRONTEND_URL="http://localhost:5173"

# Supabase (Opcional si se requiere Storage de imágenes público)
SUPABASE_URL=""
SUPABASE_KEY=""
